<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <RelativeLayout
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:padding="16dp"
                android:id="@+id/ic_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_back_3"/>

        </RelativeLayout>

        <LinearLayout
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.25"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#3E4453"
                android:fontFamily="@font/semi_bold"
                android:text="@string/over92"
                android:textAlignment="center"
                android:layout_marginHorizontal="24dp"/>

            <TextView
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="32dp"
                android:gravity="center_horizontal"
                android:text="@string/dont_miss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="@font/regular"
                android:textColor="#AAAAB8"/>


            <com.genesys.shape.view.ShapeTextView
                app:shape_radius="@dimen/_50sdp"
                app:shape_solidColor="#3D98FF"
                android:id="@+id/try_again"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="24dp"
                android:paddingVertical="16dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="@font/medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/try_again"/>

            <com.genesys.shape.view.ShapeTextView
                app:shape_radius="@dimen/_50sdp"
                android:id="@+id/tv_still_want"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp"
                android:paddingVertical="16dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#6B6B6B"
                android:fontFamily="@font/medium"
                app:shape_solidColor="#1A6B6B6B"
                android:backgroundTint="#338F9AB1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/still_want_to_uninstall"/>


        </LinearLayout>

        <FrameLayout
            android:id="@+id/fr_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="vertical"
            android:visibility="visible">

            <include
                android:id="@+id/shimmer_ads"
                layout="@layout/layout_shimmer_native_medium" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
