<?xml version="1.0" encoding="utf-8"?>
<layout>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/creenRating"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFDF0"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#FEAFC0"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_92sdp"
                    android:layout_height="@dimen/_78sdp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_rating_app_v2" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/txt_do_you_like_our_app"
                    android:textColor="#E59E00"
                    android:textSize="@dimen/_24sdp" />

                <TextView
                    android:id="@+id/tvContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/semi_bold"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/txt_rate_5_star"
                    android:textColor="#9B82BB"
                    android:textSize="@dimen/_11sdp" />

                <com.willy.ratingbar.ScaleRatingBar
                    android:id="@+id/simpleRatingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:srb_clickable="true"
                    app:srb_drawableEmpty="@drawable/ic_star_complate_off"
                    app:srb_drawableFilled="@drawable/ic_star_complate_on_1"
                    app:srb_numStars="5"
                    app:srb_scrollable="true"
                    app:srb_starHeight="@dimen/_30sdp"
                    app:srb_starPadding="@dimen/_4sdp"
                    app:srb_starWidth="@dimen/_30sdp"
                    app:srb_stepSize="1" />

                <TextView
                    android:id="@+id/btnRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:background="@drawable/bg_play_again"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="@string/rate"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_13sdp" />

                <TextView
                    android:id="@+id/btnLater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/semi_bold"
                    android:text="@string/txt_later"
                    android:textColor="#9B82BB"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</layout>
