<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="text_regular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:gravity">start</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="rounded_corner">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="RoundedCorner_9">
        <item name="cornerSize">@dimen/_9sdp</item>
    </style>
    <style name="text_medium" parent="text_regular">
        <item name="android:fontFamily">@font/medium</item>
    </style>
    <style name="text_bold" parent="text_regular">
        <item name="android:fontFamily">@font/bold</item>
    </style>
    <style name="text_regular_14" parent="text_regular">
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    <style name="text_regular_12" parent="text_regular">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="text_medium_16" parent="text_medium">
        <item name="android:textSize">@dimen/_16ssp</item>
    </style>
    <style name="text_bold_16" parent="text_bold">
        <item name="android:textSize">@dimen/_16ssp</item>
    </style>
    <style name="text_bold_12" parent="text_bold">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="text_bold_10" parent="text_bold">
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_48sdp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="SettingIconContainer">
        <item name="android:layout_width">@dimen/_29sdp</item>
        <item name="android:layout_height">@dimen/_29sdp</item>
        <item name="android:background">@drawable/bg_setting_icon</item>
    </style>
    <style name="SettingIcon">
        <item name="android:layout_width">@dimen/_15sdp</item>
        <item name="android:layout_height">@dimen/_15sdp</item>
        <item name="android:layout_gravity">center</item>
    </style>
    <style name="SettingTitle" parent="text_medium_16">
        <item name="android:layout_width">0dp</item>
        <item name="fontFamily">@font/semi_bold</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_12sdp</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/color_1F0E5A</item>
    </style>
    <style name="SettingValue" parent="text_regular_14">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fontFamily">@font/medium</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
        <item name="android:textColor">#7568A2</item>
    </style>
    <style name="SettingChevron">
        <item name="android:layout_width">@dimen/_13sdp</item>
        <item name="android:layout_height">@dimen/_13sdp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">#7568A2</item>
    </style>
    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#EEE8F6</item>
    </style>
</resources>